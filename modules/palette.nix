# Shared Workstation colours: the Okabe-Ito colour-blind-safe accents on
# neutral dark grey. A plain attribute set, read with `import`, not a module.
# Never use red against green as the only signal (the user has deuteranomaly).
{
  # Neutrals
  background = "#1e1e1e";
  surface = "#2a2a2a";
  border = "#3c3c3c";
  muted = "#8c8c8c";
  foreground = "#e0e0e0";

  # Okabe-Ito accents
  orange = "#e69f00";
  skyBlue = "#56b4e9";
  bluishGreen = "#009e73";
  yellow = "#f0e442";
  blue = "#0072b2";
  vermillion = "#d55e00";
  reddishPurple = "#cc79a7";
}
